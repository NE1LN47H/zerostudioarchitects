# ==========================================
# Zero Studio Architects - Environment Config
# ==========================================

# MongoDB Database Configuration
# MongoDB Atlas Connection String (Single Source of Truth):
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.kyyl3tp.mongodb.net/zero_studio?retryWrites=true&w=majority
MONGODB_DB=zero_studio

# Cloudinary Media Storage Configuration (CMS uploads & delivery)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Admin Authentication
AUTH_SECRET=zerostudio_auth_secret_key_change_in_production_min_32_chars
ADMIN_EMAIL=admin@zerostudio.org
ADMIN_PASSWORD=admin123456

